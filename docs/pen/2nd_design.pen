            {
              "type": "group",
              "id": "q4uT52",
              "x": 142,
              "y": 556,
              "name": "企業テーマ",
              "children": [
                {
                  "type": "text",
                  "id": "Y4cS2L",
                  "x": 0,
                  "y": 0,
                  "name": "企業テーマ",
                  "fill": "#ffffffff",
                  "textGrowth": "fixed-width-height",
                  "width": 120.26871490478516,
                  "height": 26.547300338745117,
                  "content": "企業テーマ",
                  "fontFamily": "Inter",
                  "fontSize": 24,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "esCM2",
                  "x": 0,
                  "y": 38.720401763916016,
                  "name": "全ての人が輝ける環境づくりを目指して。 2ndの社名には、一番ではなくても輝ける世界。をテーマに名付けました。",
                  "fill": "#ffffffff",
                  "textGrowth": "fixed-width-height",
                  "width": 482,
                  "height": 73.74249267578125,
                  "content": "全ての人が輝ける環境づくりを目指して。\n2ndの社名には、一番ではなくても輝ける世界。をテーマに名付けました。\n",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "text",
              "id": "ItP2C",
