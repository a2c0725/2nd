            },
            {
              "type": "group",
              "id": "T2cS5",
              "x": 142,
              "y": 406,
              "name": "2ndとは",
              "children": [
                {
                  "type": "text",
                  "id": "lNNe5",
                  "x": 0,
                  "y": 0,
                  "name": "2nd とは",
                  "fill": "#ffffffff",
                  "textGrowth": "fixed-width-height",
                  "width": 126.58586120605469,
                  "height": 27.569608688354492,
                  "content": "2nd とは",
                  "fontFamily": "Inter",
                  "fontSize": 24,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "SJxVO",
                  "x": 0,
                  "y": 40,
                  "name": "2ndとは、東京都内を中心に、不動産事業、リフォーム事業を営む企業です。その他にペット事業を運営しております。",
                  "fill": "#ffffffff",
                  "textGrowth": "fixed-width-height",
                  "width": 482,
                  "height": 73.51895141601562,
                  "content": "2ndとは、東京都内を中心に、不動産事業、リフォーム事業を営む企業です。その他にペット事業を運営しております。",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "normal"
                }
              ]
            },
